{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bago5:pytest-checkpoint:1",
  "title": "BAGO5 Candidate-bound Test Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "candidate",
    "scope",
    "command",
    "executed",
    "result",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "executed": {
      "type": "boolean"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "INCONCLUSIVE"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recorded_at": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "NOT_RUN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
