{
  "description": "BAGO5 session continuity; local lifecycle hooks require host trust and an explicit project binding.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -I -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'skills','bago5-ganchos-sesion','scripts','native_hooks.py'),run_name='__main__')\" --host CODEX --event SessionStart",
            "commandWindows": "py -3 -B -I -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'skills','bago5-ganchos-sesion','scripts','native_hooks.py'),run_name='__main__')\" --host CODEX --event SessionStart",
            "timeout": 8,
            "additionalContextLimit": 6500
          }
        ],
        "matcher": "startup|resume|clear|compact|fork"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -I -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'skills','bago5-ganchos-sesion','scripts','native_hooks.py'),run_name='__main__')\" --host CODEX --event UserPromptSubmit",
