{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BAGO capability demonstration record (manual template)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "capability_id",
    "claim",
    "candidate_id",
    "status",
    "boundary",
    "entrypoint",
    "dependencies",
    "acceptance",
    "demonstration",
    "evidence",
    "limitations"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Use NOT_BUILT while the capability has no constructed candidate."
    },
    "status": {
      "enum": [
        "PROPOSED",
        "IMPLEMENTED",
        "VERIFIED",
        "DEMONSTRABLE",
        "BLOCKED"
      ]
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "demonstration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "input",
          "expected_observable"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "expected_observable": {
            "type": "string"
          },
          "observed": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result",
          "scope"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "INCONCLUSIVE"
            ]
          },
          "scope": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "preserved_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unblock_condition": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}