{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bago5.local/schemas/operation-context.v1",
  "title": "Operational continuity data; no permission or authenticated capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding", "phase_id", "action_id", "operation", "route", "intervention", "last_result", "next_step", "source_ref"],
  "properties": {
    "schema": {"enum": ["bago5.operation-context.v1"]},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "mission_id", "goal_id", "goal_revision", "candidate_id", "scope_id", "session_id"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "mission_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "goal_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "goal_revision": {"type": "integer", "minimum": 1},
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "phase_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"type": "string", "minLength": 1, "maxLength": 360},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 200},
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "operator", "target", "operation_scope", "state", "covers_operation", "current", "source_ref"],
      "properties": {
        "channel": {"type": "string", "minLength": 1, "maxLength": 64},
        "operator": {"enum": ["AGENT", "USER"]},
        "target": {"type": "string", "minLength": 1, "maxLength": 160},
        "operation_scope": {"type": "string", "minLength": 1, "maxLength": 240},
        "state": {"enum": ["OBSERVED", "REPORTED", "UNAVAILABLE", "UNKNOWN"]},
        "covers_operation": {"type": "boolean"},
        "current": {"type": "boolean"},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "intervention": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["id", "instruction", "status", "basis", "source_ref", "evidence_ref", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 360},
        "status": {"enum": ["PENDING", "REPORTED_DONE", "VERIFIED", "FAILED", "CANCELLED", "SUPERSEDED"]},
        "basis": {"enum": ["NONE", "DECLARATION", "OBSERVATION"]},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "evidence_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 240}
      }
    },
    "last_result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "summary", "source_ref"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "REPORTED", "OBSERVED", "FAILED", "UNCERTAIN"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 360},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "next_step": {"type": "string", "minLength": 1, "maxLength": 360}
  }
}
