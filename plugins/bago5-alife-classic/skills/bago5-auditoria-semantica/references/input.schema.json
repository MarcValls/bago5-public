{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit Boolean model input",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "source",
          "quote",
          "mapping"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "mapping": {
            "enum": [
              "reviewed",
              "candidate"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "context": {
            "type": "object",
            "required": [
              "project",
              "referent",
              "time",
              "condition",
              "modality",
              "scope"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "atoms": {
            "type": "object",
            "maxProperties": 10,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mapping": {
                  "const": "reviewed"
                }
              }
            },
            "then": {
              "required": [
                "expression",
                "context",
                "atoms",
                "assumptions"
              ]
            }
          }
        ]
      }
    }
  }
}
