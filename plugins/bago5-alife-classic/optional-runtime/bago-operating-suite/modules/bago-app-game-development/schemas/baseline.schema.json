{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bago.invalid/baseline.schema.json",
  "title": "Project Baseline v1",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "baseline_id",
    "captured_at",
    "origin",
    "scope",
    "environment",
    "capabilities",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "bago.app_game.baseline.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "object",
      "required": [
        "root_ref",
        "git_revision",
        "git_dirty",
        "snapshot_sha256"
      ],
      "properties": {
        "root_ref": {
          "type": "string",
          "minLength": 1
        },
        "git_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude",
        "inventory_status",
        "files_scanned",
        "truncated",
        "coverage_gaps"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inventory_status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "target",
        "runtime",
        "configuration"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "Windows",
            "Linux",
            "macOS",
            "Other"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "visual_profile": {
          "type": "object",
          "required": [
            "viewport_width",
            "viewport_height",
            "dpr",
            "locale",
            "theme",
            "reduced_motion"
          ],
          "properties": {
            "viewport_width": {
              "type": "integer",
              "minimum": 1
            },
            "viewport_height": {
              "type": "integer",
              "minimum": 1
            },
            "dpr": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "locale": {
              "type": "string",
              "minLength": 1
            },
            "theme": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "system"
              ]
            },
            "reduced_motion": {
              "type": "boolean"
            },
            "browser_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "stable_data_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "masks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "state",
          "properties",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DECLARED",
              "OBSERVED",
              "VERIFIED",
              "FAILED",
              "NOT_RUN"
            ]
          },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "property_id",
                "modality",
                "assertion",
                "mandatory",
                "check_refs"
              ],
              "properties": {
                "property_id": {
                  "type": "string",
                  "minLength": 1
                },
                "modality": {
                  "type": "string",
                  "enum": [
                    "FUNCTIONAL",
                    "STRUCTURAL",
                    "VISUAL",
                    "INTEGRATION",
                    "GAMEPLAY",
                    "ACCESSIBILITY"
                  ]
                },
                "assertion": {
                  "type": "string",
                  "minLength": 1
                },
                "mandatory": {
                  "type": "boolean"
                },
                "check_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "locator",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "LOG",
              "DOM",
              "SCREENSHOT",
              "TEST_RESULT",
              "BUILD",
              "GAME_TRACE",
              "SOURCE_INSPECTION",
              "OTHER"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "extensions": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
