{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bago:suite:task-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "mission_id",
    "candidate",
    "check_id",
    "kind",
    "outcome",
    "dependencies",
    "artifacts",
    "execution",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "bago.suite.task.receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope_sha256",
        "suite"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite": {
          "type": "object",
          "description": "Exact identity returned by the active Suite identity provider; runtime compares deep equality."
        }
      }
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "kind": {
      "enum": [
        "execution",
        "artifact"
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "INTERRUPTED",
        "ERROR",
        "INCONCLUSIVE"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "receipt_sha256"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "path",
          "sha256",
          "size",
          "schema"
        ],
        "properties": {
          "root": {
            "enum": [
              "state",
              "workspace"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "schema": {
            "enum": [
              null,
              "bago.suite.check-result.v1"
            ]
          }
        }
      }
    },
    "execution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "argv",
            "cwd",
            "pid",
            "started_at",
            "finished_at",
            "returncode",
            "interruption"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "pid": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "finished_at": {
              "type": "string",
              "format": "date-time"
            },
            "returncode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "interruption": {
              "enum": [
                "NONE",
                "REQUESTED",
                "TERMINATED",
                "TIMEOUT",
                "TIMEOUT_TERMINATED",
                "UNINTERRUPTIBLE",
                "CONTROL_ERROR_TERMINATED"
              ]
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "execution"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "argv",
              "cwd",
              "pid",
              "started_at",
              "finished_at",
              "returncode",
              "interruption"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "returncode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "interruption": {
                "enum": [
                  "NONE",
                  "REQUESTED",
                  "TERMINATED",
                  "TIMEOUT",
                  "TIMEOUT_TERMINATED",
                  "UNINTERRUPTIBLE",
                  "CONTROL_ERROR_TERMINATED"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "Receipt schema validation alone does not prove execution. Runtime requires exact ledger binding to a real supervised process record, current file bytes, mission/candidate equality, consumed PASS dependencies and required output schemas. No external imported command claim is promoted to execution."
}
