{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bago:suite:task-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "candidate_id",
    "operation",
    "scope",
    "max_rounds",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "bago.suite.task.plan.v1"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "operation": {
      "enum": [
        "AUDIT",
        "VERIFY",
        "REPAIR",
        "PROMOTE"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "mandatory",
          "depends_on",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "kind": {
            "enum": [
              "execution",
              "artifact"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "artifacts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "schema"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Portable safe relative path; runtime rejects traversal, symlinks, aliases and reserved devices."
                },
                "schema": {
                  "enum": [
                    null,
                    "bago.suite.check-result.v1"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "PROMOTE"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ]
      }
    }
  ],
  "description": "Frozen exact candidate file list and check DAG. Runtime also validates acyclic dependencies, collision-free safe paths, output/input separation, at least one mandatory check, and current Suite identity. No new files are automatically discovered. Dependency depth is limited to 64."
}
