{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bago:cdp:capability-demonstration:v1",
  "title": "BAGO-CDP-001 capability-level demonstration record",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "project_id", "capability_id", "claim", "candidate_id", "state", "route", "checks", "evidence", "limits"],
  "properties": {
    "schema": {"const": "bago.cdp.capability_demonstration.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["PROPOSED", "IMPLEMENTED", "VERIFIED", "DEMONSTRABLE", "BLOCKED"]},
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_point", "boundary", "dependencies", "requires_unfinished_platform", "preconditions", "steps", "observation", "expected_result", "negative_path"],
      "properties": {
        "entry_point": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "requires_unfinished_platform": {"type": "boolean"},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observation": {
          "type": "object", "additionalProperties": false,
          "required": ["channel", "probe"],
          "properties": {"channel": {"enum": ["ui", "cli", "api", "trace", "state", "artifact", "hardware", "other"]}, "probe": {"type": "string", "minLength": 1}}
        },
        "expected_result": {"type": "string", "minLength": 1},
        "negative_path": {"type": "string", "minLength": 1}
      }
    },
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "result", "scope", "evidence_ref"], "properties": {
      "id": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "scope": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string"}
    }}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "limits": {"type": "array", "items": {"type": "string"}}
  }
}
