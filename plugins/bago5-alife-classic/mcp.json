{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "alife-memoria-viva": {
      "type": "streamable-http",
      "url": "https://alifememories.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "bago5-chatgpt-memoria",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "memory.read"
            ],
            "defaultScopes": [
              "memory.read",
              "memory.write",
              "vault.read",
              "vault.write"
            ]
          }
        }
      }
    }
  }
}
